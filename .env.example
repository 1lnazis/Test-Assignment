# Скопируй в .env для локальных настроек: cp .env.example .env
# Значение из терминала имеет приоритет: WORKER_COUNT=5 docker compose up --build

# Порт API на компьютере; внутри контейнера приложение слушает 8080.
APP_PORT=8080

# Допустимые валюты и уровень логов.
CURRENCIES=USD,EUR,MXN,RUB,KZT
LOG_LEVEL=info

# Фоновая обработка. MAX_ATTEMPTS включает первую попытку.
WORKER_COUNT=1
MAX_ATTEMPTS=3
POLL_INTERVAL=1s
RETRY_BASE_DELAY=1s
RETRY_MAX_DELAY=30s

# Аренда должна превышать QUOTE_TIMEOUT + 2 * DB_TIMEOUT.
QUOTE_TIMEOUT=5s
DB_TIMEOUT=3s
LEASE_DURATION=30s

# Бюджет Docker оставляем с запасом относительно остановки приложения.
SHUTDOWN_TIMEOUT=10s
STOP_GRACE_PERIOD=20s

# DATABASE_URL и внутренний HTTP_ADDR заданы непосредственно в Compose.
